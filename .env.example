# Configure na Vercel: Project → Settings → Environment Variables
#
# Opção simples: Resend (crie a conta Resend com o e-mail ascom@ictdf.org.br)
RESEND_API_KEY=
#
# Ou, alternativamente, qualquer servidor SMTP:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=ascom@ictdf.org.br
# SMTP_PASS=
#
# Opcionais
# EMAIL_FROM="Termos ICTDF <ascom@ictdf.org.br>"
# EMAIL_TO=ascom@ictdf.org.br
